<Window x:Class="RealTimeTranslater.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RealTime Translater"
        Width="760"
        Height="640"
        MinWidth="700"
        MinHeight="500"
        Loaded="MainWindow_Loaded"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="3"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Text="RealTime Translater" />
        <TextBlock Grid.Row="1"
                   Grid.ColumnSpan="3"
                   Margin="0,4,0,18"
                   Foreground="Gray"
                   Text="Select a game window, OCR its text, translate it, and draw the selected language over the original location." />

        <TextBlock Grid.Row="2"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="Target window" />
        <ComboBox x:Name="WindowComboBox"
                  Grid.Row="2"
                  Grid.Column="1"
                  Margin="0,4,8,4"
                  MinHeight="30"
                  SelectionChanged="WindowComboBox_SelectionChanged" />
        <Button x:Name="RefreshWindowsButton"
                Grid.Row="2"
                Grid.Column="2"
                Margin="0,4,0,4"
                Padding="14,4"
                Click="RefreshWindowsButton_Click"
                Content="Refresh" />

        <TextBlock Grid.Row="3"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="OCR language" />
        <ComboBox x:Name="OcrLanguageComboBox"
                  Grid.Row="3"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Margin="0,4,0,4"
                  MinHeight="30" />

        <TextBlock Grid.Row="4"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Text="Translation provider" />
        <ComboBox x:Name="ProviderComboBox"
                  Grid.Row="4"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  Margin="0,4,0,4"
                  MinHeight="30"
                  SelectionChanged="ProviderComboBox_SelectionChanged" />

        <!--
            Keep the frequently changed provider/source settings scrollable.
            This prevents them from stealing space from the status/log panel on
            small displays or when Windows display scaling is above 100%.
        -->
        <ScrollViewer Grid.Row="5"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Margin="0,8,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,2,4,2">
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Text="Text source" />
                    <ComboBox x:Name="TextSourceComboBox"
                              Grid.Column="1"
                              MinHeight="28"
                              SelectionChanged="TextSourceComboBox_SelectionChanged" />
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Text="Target language" />
                    <ComboBox x:Name="TargetLanguageComboBox"
                              Grid.Column="1"
                              MinHeight="28" />
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Text="Unity scope" />
                    <CheckBox x:Name="UnityDialogueOnlyCheckBox"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Checked="UnityDialogueOnlyCheckBox_Changed"
                              Unchecked="UnityDialogueOnlyCheckBox_Changed"
                              Content="Translate dialogue / captions / choices / prose (unchecked = all visible text)" />
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Text="Endpoint" />
                    <TextBox x:Name="EndpointTextBox"
                             Grid.Column="1"
                             MinHeight="28"
                             VerticalContentAlignment="Center" />
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Text="Ollama model" />
                    <TextBox x:Name="ModelTextBox"
                             Grid.Column="1"
                             MinHeight="28"
                             VerticalContentAlignment="Center" />
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Text="Overlay mode" />
                    <ComboBox x:Name="OverlayModeComboBox"
                              Grid.Column="1"
                              MinHeight="28" />
                </Grid>
                <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Text="Screenshots" />
                    <CheckBox x:Name="AllowScreenshotsCheckBox"
                              Grid.Column="1"
                              VerticalAlignment="Center"
                              Checked="AllowScreenshotsCheckBox_Changed"
                              Unchecked="AllowScreenshotsCheckBox_Changed"
                              Content="Allow overlay to appear in screenshots (debug)" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!--
            Reserve space for runtime diagnostics. Long errors/status messages
            scroll inside this panel rather than forcing the user to resize the
            whole window just to read them.
        -->
        <Border Grid.Row="6"
                Grid.ColumnSpan="3"
                Height="136"
                Margin="0,12,0,12"
                Padding="12"
                BorderBrush="#33000000"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           FontWeight="SemiBold"
                           Text="Status" />

                <ScrollViewer Grid.Row="1"
                              Margin="0,6,0,4"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="StatusTextBlock"
                               Padding="0,0,6,0"
                               TextWrapping="Wrap"
                               Text="Ready"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </ScrollViewer>

                <TextBlock Grid.Row="2"
                           Foreground="Gray"
                           TextWrapping="Wrap"
                           Text="Tip: smart scope translates dialogue, cinematic captions, choices, tutorials, and readable prose while filtering HUD/menu noise." />
            </Grid>
        </Border>

        <StackPanel Grid.Row="7"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="StartButton"
                    Width="110"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="StartButton_Click"
                    Content="Start" />
            <Button x:Name="StopButton"
                    Width="110"
                    Height="34"
                    IsEnabled="False"
                    Click="StopButton_Click"
                    Content="Stop" />
        </StackPanel>
    </Grid>
</Window>
